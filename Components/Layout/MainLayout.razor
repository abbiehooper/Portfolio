@using AbbiePortfolio.Components.ComponentLibrary
@inherits LayoutComponentBase

<MudThemeProvider Theme="@_theme" IsDarkMode="_isDarkMode" />
<MudPopoverProvider />
<MudDialogProvider />
<MudSnackbarProvider />

<MudLayout Style="@GetCssVariables()">
    <Header IsDarkMode="_isDarkMode" IsDarkModeChanged="@((value) => _isDarkMode = value)" />
    <MudMainContent Class="pt-14">
        @Body
    </MudMainContent>
    <Footer />
</MudLayout>

<div id="blazor-error-ui" data-nosnippet>
    An unhandled error has occurred.
    <a href="." class="reload">Reload</a>
    <span class="dismiss">🗙</span>
</div>

@code {    
    private bool _isDarkMode = false;
    private MudTheme? _theme = null;

    protected override void OnInitialized()
    {
        base.OnInitialized();

        _theme = new()
        {
            PaletteLight = _lightPalette,
            PaletteDark = _darkPalette,
            LayoutProperties = new LayoutProperties(),
            Typography = _typography,
        };
    }

    private string GetCssVariables()
    => $"--hover-color: {(_isDarkMode ? "#3A3A35" : "#D4CFC7")}";


    private readonly PaletteLight _lightPalette = new()
    {
        Primary = "#1A1A1A",
        Secondary = "#8A7E6D",
        TextPrimary = "#1A1A1A",
        TextSecondary = "#8A7E6D",

        Black = "#1A1A1A",
        AppbarText = "#1A1A1A",
        AppbarBackground = "rgba(247, 245, 240, 0.95)",
        DrawerBackground = "#F7F5F0",
        Surface = "#FFFFFF",
        GrayLight = "#E8E4DC",
        GrayLighter = "#F2EFE9",
        OverlayLight = "#D4CFC7",
        Background = "#F7F5F0",
        Divider = "#D4CFC7",
        LinesDefault = "#D4CFC7",
    };

    private readonly PaletteDark _darkPalette = new()
    {
        Primary = "#E8E4DC",
        Secondary = "#8A7E6D",

        Surface = "#252520",
        Background = "#1A1A1A",
        BackgroundGray = "#111110",
        AppbarText = "#E8E4DC",
        AppbarBackground = "rgba(26, 26, 26, 0.95)",
        DrawerBackground = "#1A1A1A",
        ActionDefault = "#8A7E6D",
        ActionDisabled = "#8A7E6D4d",
        ActionDisabledBackground = "#3a3a354d",
        TextPrimary = "#E8E4DC",
        TextSecondary = "#8A7E6D",
        TextDisabled = "#ffffff33",
        DrawerIcon = "#8A7E6D",
        DrawerText = "#8A7E6D",
        GrayLight = "#2A2A25",
        GrayLighter = "#252520",
        Info = "#8A7E6D",
        Success = "#6B8F6B",
        Warning = "#C4A86B",
        Error = "#C47B6B",
        LinesDefault = "#3A3A35",
        TableLines = "#3A3A35",
        Divider = "#3A3A35",
        OverlayDark = "#2A2A25",
    };

    private static readonly string[] headingFontArray = new[] { "Playfair Display", "Georgia", "serif" };

    private readonly Typography _typography = new Typography()
    {
        Default = new DefaultTypography()
        {
            FontFamily = new[] { "Inter", "Helvetica", "Arial", "sans-serif" },
        },
        H1 = new H1Typography { FontFamily = headingFontArray },
        H2 = new H2Typography { FontFamily = headingFontArray },
        H3 = new H3Typography { FontFamily = headingFontArray },
        H4 = new H4Typography { FontFamily = headingFontArray },
        H5 = new H5Typography { FontFamily = headingFontArray },
        H6 = new H6Typography { FontFamily = headingFontArray }
    };

    public string DarkLightModeButtonIcon => _isDarkMode switch
    {
        true => Icons.Material.Rounded.AutoMode,
        false => Icons.Material.Outlined.DarkMode,
    };
}