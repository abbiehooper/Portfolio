<MudItem xs="12" sm="6" md="6">
    <div class="project-card">
        <div class="project-image-wrap">
            <img src="@ImageUrl" alt="@Title" class="project-image" />
        </div>
        <div class="project-body">
            <div class="project-links">
                @if (!string.IsNullOrWhiteSpace(PreviewUrl))
                {
                    <a href="@PreviewUrl" target="_blank" class="project-link" aria-label="Open preview">
                        <MudIcon Icon="@Icons.Material.Outlined.OpenInNew" Size="Size.Small" />
                    </a>
                }
                <a href="@GithubUrl" target="_blank" class="project-link" aria-label="GitHub">
                    <MudIcon Icon="@Icons.Custom.Brands.GitHub" Size="Size.Small" />
                </a>
            </div>
            <MudText Typo="Typo.h5" Class="project-title">@Title</MudText>
            <MudText Typo="Typo.body2" Class="project-description">@Description</MudText>
        </div>
    </div>
</MudItem>
