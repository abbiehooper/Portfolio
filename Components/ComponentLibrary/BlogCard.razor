<MudItem xs="12" sm="6" md="6">
    <div class="blog-card">
        <div class="blog-image-wrap">
            <img src="@BlogPost.ImageUrl" alt="@BlogPost.Title" class="blog-image" />
        </div>
        <div class="blog-body">
            <span class="blog-category">@BlogPost.Category</span>
            <MudText Typo="Typo.h5" Class="blog-title">@BlogPost.Title</MudText>
            <MudText Typo="Typo.body2" Class="blog-description">@BlogPost.Description</MudText>
            <UnderlineButton Href="@BlogPost.PostUrl" ContainerClass="mt-auto pt-4" Text="Read Post →" />
        </div>
    </div>
</MudItem>

@code {

    [Parameter]
    public required BlogPost BlogPost { get; set; }

}
