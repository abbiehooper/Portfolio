<div class="contact-form-wrapper">
    <MudForm Spacing="3" @ref="form" @bind-IsValid="@success" ValidationDelay="0">
        <MudTextField T="string"
                      Label="Name*"
                      @bind-Value="contactModel.Name"
                      For="@(() => contactModel.Name)"
                      Immediate="true"
                      Variant="Variant.Text"
                      OnlyValidateIfDirty="true" />
        <MudTextField T="string"
                      Label="Email Address*"
                      @bind-Value="contactModel.Email"
                      For="@(() => contactModel.Email)"
                      Immediate="true"
                      Variant="Variant.Text"
                      OnlyValidateIfDirty="true" />
        <MudTextField T="string"
                      Label="Message*"
                      Lines="5"
                      @bind-Value="contactModel.Message"
                      For="@(() => contactModel.Message)"
                      Immediate="true"
                      Variant="Variant.Text"
                      OnlyValidateIfDirty="true" />
        <MudText Typo="Typo.body2" Class="mr-2">* Required fields</MudText>
        <div class="d-flex justify-space-between">
            <MudText Typo="Typo.body2" Class="mr-2" Color="Color.Secondary">Submitting sends me an email · no list, no spam.</MudText>
            <Button ButtonText="Send inquiry →"
                    OnClick="SendEmail"
                    Type="ButtonType.Submit"
                    Enabled="CanSubmit"
                    LoadingText="Sending..."
                    Loading="sending" />
        </div>

    </MudForm>
</div>
