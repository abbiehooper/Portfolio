@using AbbiePortfolio.Components.ComponentLibrary
<section class="editorial-section" id="projects" style="scroll-margin-top: 56px;">
    <MudContainer MaxWidth="MaxWidth.Large">
        <hr class="section-rule" />
        <div class="d-flex align-center justify-space-between mb-10">
            <div>
                <p class="section-label">01 — Work</p>
                <MudText Typo="Typo.h2" Style="font-style: italic; font-weight: 400;">Projects</MudText>
            </div>
        </div>
        <MudGrid Spacing="4">
            @foreach (var project in projects)
            {
                <ProjectCard Title="@project.Title"
                             Description="@project.Description"
                             ImageUrl="@project.ImageUrl"
                             PreviewUrl="@project.PreviewUrl"
                             GithubUrl="@project.GithubUrl" />
            }
        </MudGrid>
    </MudContainer>
</section>
