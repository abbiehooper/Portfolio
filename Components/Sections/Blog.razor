@using AbbiePortfolio.Components.ComponentLibrary
<section class="editorial-section" id="blog" style="scroll-margin-top: 56px;">
    <MudContainer MaxWidth="MaxWidth.Large">
        <hr class="section-rule" />
        <div class="d-flex align-center justify-space-between mb-10">
            <div>
                <p class="section-label">02 — Writing</p>
                <MudText Typo="Typo.h2" Style="font-style: italic; font-weight: 400;">Blog</MudText>
            </div>
        </div>
        <MudGrid Spacing="4">
            @if (Blogs != null && Blogs.Count > 0)
            {
                <BlogCard BlogPost="Blogs[0]" />
                <BlogCard BlogPost="Blogs[1]" />
            }
            else
            {
                <MudItem xs="12" sm="6">
                    <MudCard Elevation="0" Outlined="true" Style="height: 100%;">
                        <MudSkeleton SkeletonType="SkeletonType.Rectangle" Height="240px" />
                        <MudCardContent>
                            <MudSkeleton Width="30%" Height="16px;" Class="mb-2" />
                            <MudSkeleton Width="60%" Height="28px;" Class="mb-2" />
                            <MudSkeleton Width="90%" />
                            <MudSkeleton Width="100%" />
                        </MudCardContent>
                    </MudCard>
                </MudItem>

                <MudItem xs="12" sm="6">
                    <MudCard Elevation="0" Outlined="true" Style="height: 100%;">
                        <MudSkeleton SkeletonType="SkeletonType.Rectangle" Height="240px" />
                        <MudCardContent>
                            <MudSkeleton Width="30%" Height="16px;" Class="mb-2" />
                            <MudSkeleton Width="60%" Height="28px;" Class="mb-2" />
                            <MudSkeleton Width="90%" />
                            <MudSkeleton Width="100%" />
                        </MudCardContent>
                    </MudCard>
                </MudItem>
            }
        </MudGrid>
    </MudContainer>
</section>
