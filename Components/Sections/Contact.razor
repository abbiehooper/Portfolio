@using AbbiePortfolio.Components.ComponentLibrary

<section class="editorial-section" id="contact" style="scroll-margin-top: 56px;">
    <MudContainer MaxWidth="MaxWidth.Large">
        <hr class="section-rule" />
        <div class="mb-10">
            <p class="section-label">03 — Get in Touch</p>
            <MudText Typo="Typo.h2" Style="font-style: italic; font-weight: 400;">Contact</MudText>
        </div>

        <MudContainer MaxWidth="MaxWidth.Large">
            <MudGrid Spacing="8">
                <MudItem xs="12" md="6" lg="3" xl="3">
                    <div class="d-flex flex-column gap-4">
                        <div>
                            <p class="section-label">Direct</p>
                            <p class="email">abigailshooper@gmail.com</p>
                        </div>

                        <div>
                            <p class="section-label">Hours</p>
                            <p class="hours">
                                Mon — Thu, 09:30 — 17:00 GMT
                                <br />
                                Replies within two working days.
                            </p>
                        </div>
                    </div>
                </MudItem>

                <MudItem xs="12" md="6" lg="9" xl="9">
                    <ContactForm />
                </MudItem>
            </MudGrid>
        </MudContainer>
    </MudContainer>
</section>