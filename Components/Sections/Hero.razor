@using AbbiePortfolio.Components.ComponentLibrary
@inject IJSRuntime JS

<section class="hero-section">
    <MudContainer MaxWidth="MaxWidth.Large">
        <div class="hero-inner">
            <div class="hero-heading fade-in-item fade-in-1">
                <span class="hero-greeting">Hi, I'm</span>
                <h1 class="hero-text">Abbie Hooper -</h1>
                <h1 class="hero-text"><em>Senior Software Engineer.</em></h1>
            </div>
            <div class="hero-footer fade-in-item fade-in-2">
                <p class="hero-role">About me</p>
                <p class="hero-description">
                    I love designing and building web applications with a focus on clean, maintainable code and great user experiences. 
                    I have a strong background in full-stack development, particularly with .NET and JavaScript frameworks. 
                    I am currently working for a global insurance broker, writing front-end Blazor applications for internal users and external clients.
                    I'm passionate about learning new technologies and continuously improving my skills. 
                </p>
                <UnderlineButton OnClick=DownloadCV Text="Download my CV →" />
            </div>
        </div>
    </MudContainer>
</section>

@code {
    private async Task DownloadCV()
    {
        await JS.InvokeVoidAsync("downloadFile", "/files/Abigail_Hooper_CV.docx", "Abigail_Hooper_CV.docx");
    }
}
