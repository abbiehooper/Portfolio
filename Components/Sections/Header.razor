@using AbbiePortfolio.Components.ComponentLibrary
@using AbbiePortfolio.Components.Pages
<MudAppBar Elevation="0" Fixed="true" Dense="true">
    <div class="name">
        <MudText Typo="Typo.h6" Style="font-family: 'Playfair Display', Georgia, serif; font-style: italic; font-weight: 400; letter-spacing: 0.01em;">Abbie Hooper</MudText>
    </div>

    <div class="nav-links">
        <NavigateToSectionLink SectionId="projects" Title="Projects" HoverColour="transparent" />
        <NavigateToSectionLink SectionId="blog" Title="Blog" HoverColour="transparent" />
        <NavigateToSectionLink SectionId="contact" Title="Contact" HoverColour="transparent" />
    </div>

    <div class="theme">
        <MudIconButton Icon="@(IsDarkMode? Icons.Material.Outlined.LightMode : Icons.Material.Outlined.DarkMode)"
                       Color="Color.Inherit"
                       Size="Size.Small"
                       OnClick="@DarkModeToggle" />
    </div>
</MudAppBar>

@code {
    [Parameter]
    public bool IsDarkMode { get; set; } = false;

    [Parameter]
    public EventCallback<bool> IsDarkModeChanged { get; set; }

    private void DarkModeToggle()
    {
        IsDarkMode = !IsDarkMode;
        IsDarkModeChanged.InvokeAsync(IsDarkMode);
    }
}
